{
  "name": "forum-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "lsof -ti :3001 | xargs kill -9 2>/dev/null; tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:deploy": "prisma migrate deploy",
    "db:check": "bash scripts/db-check.sh",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "search:reindex": "tsx src/scripts/reindex.ts",
    "points:audit": "tsx src/scripts/audit-points.ts",
    "nodeloc:extract": "tsx src/scripts/import-nodeloc/extract-nodeloc-sql.ts",
    "nodeloc:init": "tsx src/scripts/import-nodeloc/initialize-nodeloc.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.7.0",
    "argon2": "~0.41.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.11.0",
    "ioredis": "^5.6.0",
    "jose": "^5.9.0",
    "meilisearch": "~0.48.0",
    "nanoid": "^5.1.0",
    "node-emoji": "^2.2.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.3",
    "slugify": "^1.6.0",
    "unicode-emoji-json": "^0.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "prisma": "^7.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
