# ── 基础 ──
# 运行环境：development | production（区分 /test-tg 等开发专用逻辑）
NODE_ENV=development
# 服务监听端口与地址
PORT=3001
HOST=0.0.0.0

# ── 数据存储（均为必填） ──
# PostgreSQL 连接字符串（本地开发用本机用户名登录，测试/生产填对应库）
DATABASE_URL="postgresql://rob@localhost:5432/forum"
# 仅开发期生成迁移需要（可选）：migrate diff --from-migrations / migrate dev 用临时 shadow 库回放迁移历史。
# 指向任意本地 PG 连接（Prisma 自动建临时 shadow 库并删除）；不设置则这两个命令不可用，migrate deploy 不受影响。
# SHADOW_DATABASE_URL="postgresql://rob@localhost:5432/postgres"
# Redis 连接字符串
REDIS_URL="redis://localhost:6379"

# ── 浏览器源白名单（CORS 与 CSRF 共用，必填） ──
# 逗号分隔多域名；本地 http://localhost:3000，测试/生产填真实前端域名
ALLOWED_ORIGINS="http://localhost:3000"

# ── 认证 ──
# Telegram Bot Token，用于 TG Login Widget 验签（无 TG 登录可留空）
TELEGRAM_BOT_TOKEN=""

# 管理后台服务间密钥（必填）——admin 后端调用 /api/admin/* 时在 X-Admin-Key 头携带。
# 必须与 admin/server 侧的 FORUM_ADMIN_KEY 保持一致，生产环境用随机长字符串
FORUM_ADMIN_KEY="change-me-admin-key"

# ── 图片上传 ──
# 图片基础 URL（必填）——DB 只存相对路径，API 返回时拼接此前缀。
# 本地 http://localhost:3001，测试/生产填能访问到上传文件的公网域名（或由反代同源提供则填前端域名）
UPLOAD_BASE_URL="http://localhost:3001"
# 单文件最大字节数，默认 10MB
UPLOAD_MAX_FILE_SIZE=10485760
# 单用户累计上传总字节数上限，默认 50MB
UPLOAD_MAX_USER_TOTAL_SIZE=52428800
# 单用户每分钟最大上传次数，默认 20
UPLOAD_MAX_UPLOADS_PER_MINUTE=20

# ── 帖子 ──
# 帖子正文最少字符数，防止水帖，默认 10
POST_MIN_CONTENT_LENGTH=10

# ── 数据导入（NodeLoc） ──
# 增量同步开关，默认关闭。必须在「全量回填 + 阶段 2.5 造数」都完成后才显式置 true，
# 否则实时积分重放会与造数重复计账（见 docs/NodeLoc数据迁移手册.md）。
IMPORT_SYNC_ENABLED=false

# ── 搜索（Meilisearch） ──
# Meilisearch 地址。本地 dev 用 Homebrew 原生实例；测试/生产填 compose 内服务名（http://meilisearch:7700）
MEILI_HOST="http://localhost:7700"
# Meilisearch master key。本地 dev 无 key 留空；测试/生产必填，与 compose 的 MEILI_MASTER_KEY 一致
MEILI_MASTER_KEY=""
