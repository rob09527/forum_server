# Server
PORT=3001
HOST=0.0.0.0

# PostgreSQL (本地开发用当前用户登录)
DATABASE_URL="postgresql://rob@localhost:5432/forum"

# Redis
REDIS_URL="redis://localhost:6379"

# MeiliSearch (如果没设 master key 可以留空)
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="dev_master_key"

# Auth — 生产环境换成随机长字符串
JWT_SECRET="change-me-in-production-use-a-long-random-string"

# 管理后台服务间密钥（必填）——admin 后端调用 /api/admin/* 时在 X-Admin-Key 头携带。
# 必须与 admin/server 侧的 FORUM_ADMIN_KEY 保持一致，生产环境用随机长字符串
FORUM_ADMIN_KEY="change-me-admin-key"
