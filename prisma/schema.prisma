generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  /// 用户 ID，自增主键
  id            Int       @id @default(autoincrement())

  /// 用户名，唯一，3-20 字符，用于展示和 @提及
  username      String    @unique

  /// 邮箱，唯一；TG 注册时为空(null)，绑定邮箱后才有值
  email         String?   @unique

  /// argon2id 密码哈希；TG 注册时为空(null)，绑定邮箱设密码后才有值
  passwordHash  String?

  /// 头像 URL；TG 注册自动填 TG 头像；邮箱注册默认 null（前端展示默认头像）
  avatar        String?

  /// 个人简介，最长 200 字符
  bio           String?

  /// 用户等级：claw(鸡爪/新手) | leg(鸡腿/中级) | meat(鸡肉/高级)
  level         String    @default("claw")

  /// 鸡腿积分，通过签到/发帖/评论获得
  points        Int       @default(0)

  /// 星辰(特殊积分)，通过精华帖/管理奖励获得
  stars         Int       @default(0)

  /// 发帖总数，冗余字段，避免每次 COUNT 查询
  postCount     Int       @default(0)

  /// 评论总数，冗余字段，避免每次 COUNT 查询
  commentCount  Int       @default(0)

  /// 管理角色：user(普通用户) | mod(版主) | admin(管理员)
  role          String    @default("user")

  /// 第三方登录来源：'telegram' 表示 TG 用户；本站邮箱注册为 null
  oauthProvider String?

  /// TG 平台返回的用户 ID(纯数字字符串)；本站邮箱注册为 null
  oauthId       String?   @unique

  /// 邮箱是否已验证（MVP 阶段暂不强制，预留字段）
  emailVerified Boolean   @default(false)

  /// 注册时间
  createdAt     DateTime  @default(now())

  /// 最后更新时间
  updatedAt     DateTime  @updatedAt

  @@map("users")
}
