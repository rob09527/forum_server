generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  /// 用户 ID，自增主键
  id            Int       @id @default(autoincrement())

  /// 用户名，唯一，3-20 字符，用于展示和 @提及
  username      String    @unique

  /// 邮箱，唯一；TG 注册时为空(null)，绑定邮箱后才有值
  email         String?   @unique

  /// argon2id 密码哈希；TG 注册时为空(null)，绑定邮箱设密码后才有值
  passwordHash  String?

  /// 头像 URL；TG 注册自动填 TG 头像；邮箱注册默认 null（前端展示默认头像）
  avatar        String?

  /// 个人简介，最长 200 字符
  bio           String?

  /// 用户等级：claw(鸡爪/新手) | leg(鸡腿/中级) | meat(鸡肉/高级)
  level         String    @default("claw")

  /// 鸡腿积分，通过签到/发帖/评论获得
  points        Int       @default(0)

  /// 星辰(特殊积分)，通过精华帖/管理奖励获得
  stars         Int       @default(0)

  /// 发帖总数，冗余字段，避免每次 COUNT 查询
  postCount     Int       @default(0)

  /// 评论总数，冗余字段，避免每次 COUNT 查询
  commentCount  Int       @default(0)

  /// 管理角色：user(普通用户) | mod(版主) | admin(管理员)
  role          String    @default("user")

  /// 账号状态：active(正常) | banned(封禁) | muted(禁言)
  status        String    @default("active")

  /// 第三方登录来源：'telegram' 表示 TG 用户；本站邮箱注册为 null
  oauthProvider String?

  /// TG 平台返回的用户 ID(纯数字字符串)；本站邮箱注册为 null
  oauthId       String?   @unique

  /// 邮箱是否已验证（MVP 阶段暂不强制，预留字段）
  emailVerified Boolean   @default(false)

  /// 累计上传图片总字节数，上传前校验不超过 UPLOAD_MAX_USER_TOTAL_SIZE
  uploadSize    Int       @default(0)

  /// 累计获得鸡腿（只增不减），等级升级依据 [R20]
  totalPointsEarned Int   @default(0)

  /// 连续签到天数，断签归零 [R13]
  checkinStreak Int       @default(0)

  /// 累计签到天数，永不归零 [R13]
  checkinTotalDays Int    @default(0)

  /// 上次签到时间，用于判断是否断签 [R13]
  lastCheckinAt DateTime?

  // ── 装饰生效槽（消费体系，见 docs/积分消费体系.md）──
  // 反规范化的「当前生效」状态：单槽模型（同类每人只保留一个）等价于用户表上一个列槽位，
  // 全站用户名渲染点零 JOIN 直接读 [1.2][1.3.3]

  /// 生效中的用户名颜色渲染值（CSS 色值或渐变，如 #a855f7）；未持有为 null [R44]
  /// 购买时从 ShopItem.renderValue 快照而来，商品事后改价/改值/下架均不影响本列 [1.3.3]
  decorColorValue     String?

  /// 用户名颜色到期时间；渲染时内联判定 now < 本列才生效，过期不清空（靠时间判定，零清理成本）[R46]
  decorColorExpireAt  DateTime?

  /// 生效中的专属称号文本（如「卷王」）；未持有为 null
  decorTitleValue     String?

  /// 称号徽章配色 key（amber | violet | emerald …），与 decorTitleValue 成对存储
  decorTitleStyle     String?

  /// 称号到期时间，语义同 decorColorExpireAt
  decorTitleExpireAt  DateTime?

  /// 生效中的租用头像路径（付费头像快照，/avatars/{style}/avatar-{nn}.svg）；未租用为 null
  decorAvatarValue     String?

  /// 租用头像到期时间；过期不清空，渲染时折叠回 User.avatar（基础头像），靠时间判定 [R46]
  decorAvatarExpireAt  DateTime?

  /// 上传配额加购字节数（扩容道具累加，永久有效）；
  /// 实际配额 = config.UPLOAD_MAX_USER_TOTAL_SIZE + 本列，见 upload.service 校验 [1.4.2]
  uploadQuotaBonus    Int       @default(0)

  /// 私信隐私开关：everyone(所有人可私信) | followers(仅关注我的人) | nobody(关闭私信)
  dmPrivacy      String    @default("everyone")

  /// 积分流水记录
  pointLogs     PointLog[]

  /// 注册时间
  createdAt     DateTime  @default(now())

  /// 最后更新时间
  updatedAt     DateTime  @updatedAt

  /// 用户发布的帖子
  posts         Post[]

  /// 用户发布的评论
  comments      Comment[]

  /// 用户的帖子点赞记录
  postLikes     PostLike[]

  /// 用户的评论点赞记录
  commentLikes  CommentLike[]

  /// 粉丝数（冗余，关注/取关时同步增减，避免 COUNT）
  followerCount  Int           @default(0)

  /// 关注数（冗余）
  followingCount Int           @default(0)

  /// 用户的收藏记录
  bookmarks      Bookmark[]

  /// 关注关系（用户主动关注的人）
  following      Follow[]      @relation("Follows")

  /// 关注关系（关注该用户的人）
  followers      Follow[]      @relation("Followers")

  /// 用户的通知
  notifications  Notification[]

  @@index([status])
  @@map("users")
}

/// 论坛帖子
model Post {
  /// 帖子 ID，自增主键
  id           Int       @id @default(autoincrement())

  /// 帖子标题，1-200 字符
  title        String

  /// Markdown 格式正文
  content      String    @db.Text

  /// 所属板块，对应 Category 枚举值：general | llm | agent | prompt | art | opensource | tools | paper | share
  category     String

  /// 标签列表，最多 5 个，每个最长 20 字符，用 PG 数组存储 + GIN 索引
  tags         String[]

  /// 作者 ID
  authorId     Int

  /// 作者
  author       User      @relation(fields: [authorId], references: [id])

  /// 浏览量（Redis 去重计数后定时回写）
  viewCount    Int       @default(0)

  /// 点赞数（冗余字段，点赞时更新）
  likeCount    Int       @default(0)

  /// 评论数（冗余字段，发评论时更新）
  commentCount Int       @default(0)

  /// 热度分（物化列：likeCount*300 + commentCount*200 + viewCount，点赞/评论/浏览写路径增量维护）
  heatScore    Int       @default(0)

  // ── 消费体系冗余列（见 docs/积分消费体系.md，写路径增量维护、读路径零聚合）──

  /// 打赏人数（冗余；因 [R48] 一人一次，人数 = 笔数，展示无需去重）[1.4]
  tipCount     Int       @default(0)

  /// 打赏总额（冗余；详情页「共 328」直接读，不做 SUM 聚合）[1.4]
  tipAmount    Int       @default(0)

  /// 悬赏金额；null 表示非悬赏帖。列表徽章靠本列渲染，避免列表页 JOIN bounties [1.5]
  bountyAmount Int?

  /// 悬赏状态（同 Bounty.status 的冗余）；null 表示非悬赏帖。用于列表筛选「待解决的悬赏」[1.5]
  bountyStatus String?

  /// 是否置顶，置顶帖列表优先展示（admin 模块后续提供置顶 API）
  isPinned     Boolean   @default(false)

  /// 发布时间
  createdAt    DateTime  @default(now())

  /// 最后更新时间（编辑后自动更新，前端展示"最后编辑于"）
  updatedAt    DateTime  @updatedAt

  /// 帖子下的评论
  comments     Comment[]

  /// 帖子的点赞记录
  likes        PostLike[]

  /// 帖子的收藏记录
  bookmarks    Bookmark[]

  @@index([category, createdAt(sort: Desc)])
  @@index([authorId])
  @@index([createdAt])
  @@index([tags], type: Gin) // 标签筛选 GIN 索引，tags: { has: tag } 查询依赖
  // 置顶优先 + 时间倒序（latest 首页/板块列表），让 orderBy([isPinned, createdAt]) 走索引
  @@index([isPinned, createdAt(sort: Desc)])
  @@index([category, isPinned, createdAt(sort: Desc)])
  // 热度窗口扫描：索引服务 hot 列表的 WHERE createdAt >= 7d 范围过滤；排序首键 isPinned 无法并入本索引，
  // 残余 isPinned+heatScore 排序为有界窗口内小集合显式排序（可接受，已消除全量拉回内存 JS 排序）
  @@index([createdAt, heatScore(sort: Desc)])
  /// 悬赏聚合入口：筛选托管中的悬赏帖 + 时间倒序 [1.5]
  @@index([bountyStatus, createdAt(sort: Desc)])
  @@map("posts")
}

/// 帖子评论（支持楼中楼回复）
model Comment {
  /// 评论 ID，自增主键
  id        Int       @id @default(autoincrement())

  /// Markdown 格式评论内容
  content   String    @db.Text

  /// 所属帖子 ID，帖子删除时级联删除评论
  postId    Int

  /// 所属帖子
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// 评论者 ID
  authorId  Int

  /// 评论者
  author    User      @relation(fields: [authorId], references: [id])

  /// 回复目标评论 ID，null 表示顶层楼层，有值表示楼中楼回复
  parentId  Int?

  /// 回复的目标评论（删除父评论时级联删除其所有楼中楼回复）
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)

  /// 该评论下的楼中楼回复
  replies   Comment[] @relation("CommentReplies")

  /// 楼层号（同一帖子内唯一），顶层评论才分配，楼中楼回复为 null
  floor     Int?

  /// 点赞数（冗余字段，点赞时更新）
  likeCount Int       @default(0)

  // ── 消费体系冗余列（见 docs/积分消费体系.md）──
  /// 打赏人数（冗余；评论区轻量展示 🍗 3）[1.4]
  tipCount   Int       @default(0)
  /// 打赏总额（冗余）[1.4]
  tipAmount  Int       @default(0)

  /// 评论时间
  createdAt DateTime  @default(now())

  /// 评论的点赞记录
  likes     CommentLike[]

  @@unique([postId, floor])
  @@index([postId, createdAt])
  @@index([authorId])
  @@map("comments")
}

/// 帖子点赞记录
model PostLike {
  /// 点赞记录 ID
  id        Int      @id @default(autoincrement())

  /// 被点赞的帖子 ID，帖子删除时级联删除
  postId    Int

  /// 被点赞的帖子
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// 点赞用户 ID
  userId    Int

  /// 点赞用户
  user      User     @relation(fields: [userId], references: [id])

  /// 点赞时间
  createdAt DateTime @default(now())

  /// 是否仍处于点赞状态；取消点赞置 false 保留记录，重赞时不重复发分
  active    Boolean  @default(true)

  /// 同一用户对同一帖子只能点一次赞
  @@unique([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

/// 评论点赞记录
model CommentLike {
  /// 点赞记录 ID
  id        Int      @id @default(autoincrement())

  /// 被点赞的评论 ID，评论删除时级联删除
  commentId Int

  /// 被点赞的评论
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  /// 点赞用户 ID
  userId    Int

  /// 点赞用户
  user      User     @relation(fields: [userId], references: [id])

  /// 点赞时间
  createdAt DateTime @default(now())

  /// 是否仍处于点赞状态；取消点赞置 false 保留记录，重赞时不重复发分
  active    Boolean  @default(true)

  /// 同一用户对同一评论只能点一次赞
  @@unique([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

/// 积分流水记录
model PointLog {
  /// 流水 ID，自增主键
  id           Int      @id @default(autoincrement())

  /// 用户 ID
  userId       Int

  /// 用户
  user         User     @relation(fields: [userId], references: [id])

  /// 积分来源：checkin(签到) | post(发帖) | comment(评论) | liked(被点赞) | transfer(管理调整)
  type         String

  /// 变动值（正数加分；transfer 管理调整可为负）[R41]
  delta        Int

  /// 变动后的鸡腿余额，用于流水对账 [R42]
  balanceAfter Int

  /// 关联的帖子/评论 ID，用于溯源，无关联为 null
  refId        Int?

  /// 操作者（管理调整 transfer 时记录是哪个管理员操作的），非 transfer 流水为 null
  operator     String?

  /// 变动时间
  createdAt    DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  /// 按类型派生限流（补签月次数、改名冷却）+ 后台按类型统计各出口消费占比 [1.6]
  @@index([userId, type, createdAt(sort: Desc)])
  @@map("point_logs")
}

/// 论坛板块分类（DB 驱动，替代 constants/business.ts 里的写死常量）
model Category {
  /// 分类 ID，自增主键
  id        Int      @id @default(autoincrement())

  /// 板块 slug，对应 posts.category 字段值，唯一
  slug      String   @unique

  /// 板块中文名
  name      String

  /// 板块 emoji 图标
  icon      String   @default("📂")

  /// 排序权重，越小越靠前
  sortOrder Int      @default(0)

  /// 是否启用（禁用后从 /api/categories 隐藏、发帖不可选）
  isEnabled Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

/// 论坛公告
model Announcement {
  /// 公告 ID，自增主键
  id        Int      @id @default(autoincrement())

  /// 公告标题，1-200 字符
  title     String

  /// 公告类型：normal(普通) | important(重要) | urgent(紧急) | activity(活动)
  type      String   @default("normal")

  /// 跳转链接；站内路径(/post/1)或外链，null 表示不可点击
  link      String?

  /// 排序权重，越大越靠前
  sortOrder Int      @default(0)

  /// 是否上线（false 为草稿，前台不展示）
  isActive  Boolean  @default(true)

  /// 创建时间
  createdAt DateTime @default(now())

  /// 最后更新时间
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder(sort: Desc)])
  @@map("announcements")
}

/// 论坛广告位
model Advert {
  /// 广告 ID，自增主键
  id        Int      @id @default(autoincrement())

  /// 广告标题（后台识别 + img alt），可空
  title     String?

  /// banner 图片 URL（后台 cl-upload 返回的完整 URL）
  image     String

  /// 广告位置：sidebar(侧边栏) | inline(列表内嵌)
  position  String   @default("sidebar")

  /// 跳转链接；站内路径(/post/1)或外链，null 表示不可点击
  link      String?

  /// 排序权重，越大越靠前
  sortOrder Int      @default(0)

  /// 是否上线（false 为草稿，前台不展示）
  isActive  Boolean  @default(true)

  /// 创建时间
  createdAt DateTime @default(now())

  /// 最后更新时间
  updatedAt DateTime @updatedAt

  @@index([position, isActive, sortOrder(sort: Desc)])
  @@map("adverts")
}

/// 帖子收藏（私密，仅本人可见）
model Bookmark {
  /// 收藏记录 ID
  id        Int      @id @default(autoincrement())

  /// 收藏用户 ID
  userId    Int

  /// 收藏用户
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 被收藏的帖子 ID，帖子删除时级联删除收藏记录
  postId    Int

  /// 被收藏的帖子
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// 收藏时间
  createdAt DateTime @default(now())

  /// 同一用户对同一帖子只能收藏一次
  @@unique([userId, postId])
  @@index([postId])
  @@map("bookmarks")
}

/// 关注关系（单向 follow：follower 关注 followee，Twitter 式非双向好友）
model Follow {
  /// 关注记录 ID
  id         Int      @id @default(autoincrement())

  /// 关注者 ID（主动关注的一方）
  followerId Int

  /// 关注者
  follower   User     @relation("Follows", fields: [followerId], references: [id], onDelete: Cascade)

  /// 被关注者 ID
  followeeId Int

  /// 被关注者
  followee   User     @relation("Followers", fields: [followeeId], references: [id], onDelete: Cascade)

  /// 关注时间
  createdAt  DateTime @default(now())

  /// 同一用户对同一目标只能关注一次
  @@unique([followerId, followeeId])
  @@index([followeeId])
  @@map("follows")
}

/// 站内通知
model Notification {
  /// 通知 ID
  id        Int      @id @default(autoincrement())

  /// 接收者 ID
  userId    Int

  /// 接收者
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 通知类型：comment(评论我的帖子) | reply(回复我的评论) | like(被点赞，聚合) | follow(被关注) | system(系统通知)
  type      String

  /// 触发者 ID 列表，只保留最近 3 个（防无界数组 + 整列重写）；总数见 actorCount
  actorIds  Int[]

  /// 触发者总数（聚合通知的累计事件数，like/follow 因唯一约束等于不同人数；comment 为评论次数近似）
  actorCount Int    @default(0)

  /// 关联帖子 ID（comment/reply/like-post 用；system 可选跳转；帖子删除后跳转会失效，前端兜底）
  postId    Int?

  /// 关联评论 ID（reply/like-comment 用）
  commentId Int?

  /// 群发消息 ID（system 通知指向 notification_messages 表，正文不逐行冗余；其余类型为 null）
  messageId Int?

  /// 通知正文（system 通知用；comment/reply/like 由关联对象推导，可空）
  /// 新群发不再逐行写正文，由 messageId 指向 notification_messages；存量行仍用本列兜底
  content   String?

  /// 是否已读
  isRead    Boolean  @default(false)

  /// 通知时间
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([messageId])
  @@map("notifications")
}

/// 系统通知群发正文（广播时正文只存一份，通知行通过 messageId 引用，避免逐用户冗余存储）
model NotificationMessage {
  /// 消息 ID
  id        Int      @id @default(autoincrement())

  /// 通知正文
  content   String   @db.Text

  /// 跳转帖子 ID（可选）
  postId    Int?

  /// 实际送达用户数
  sentCount Int      @default(0)

  /// 创建时间
  createdAt DateTime @default(now())

  @@map("notification_messages")
}

// ══════════════════════════════════════════════════════════════════════
// 消费体系模型（规则来源 docs/积分消费体系.md，编号 [R44] 起）
// ══════════════════════════════════════════════════════════════════════

/// 装饰商品目录（后台 CRUD 维护，前台只读）[1.3]
model ShopItem {
  /// 商品 ID
  id           Int      @id @default(autoincrement())

  /// 装饰类型：username_color(用户名颜色) | title(专属称号)，同类互相覆盖、不同类共存 [1.3.3]
  type         String

  /// 商品名（前台展示，如「幻紫」）
  name         String

  /// 渲染值：颜色类为 CSS 色值/渐变；称号类为称号文本。购买时快照到 UserDecoration 与 User 槽位
  renderValue  String

  /// 附加样式 key（称号徽章配色）；颜色类为 null
  renderStyle  String?

  /// 价格（鸡腿），改价不影响已售出 [2.2]
  price        Int

  /// 时效天数（入门色 7 / 精选色与称号 30）[1.7]
  durationDays Int

  /// 是否上架；下架后商城隐藏、不可购买，已持有者不受影响 [2.2]
  isActive     Boolean  @default(true)

  /// 排序权重，越小越靠前
  sortOrder    Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// 商城列表：按类型分组 + 只看上架 + 排序
  @@index([type, isActive, sortOrder])
  @@map("shop_items")
}

/// 用户装饰持有记录（续费入口 + 客诉查询依据）
/// 与 User 上的生效槽的分工：槽位是「当前生效的那一个」，本表是「买过的每一个」[1.3]
model UserDecoration {
  /// 持有记录 ID
  id                Int      @id @default(autoincrement())

  /// 持有用户 ID
  userId            Int

  /// 商品 ID；续费需要跳回商品，故商品禁删只能下架 [2.2]
  itemId            Int

  /// 装饰类型（冗余自 ShopItem.type，「我的装饰」按类型分组时免 JOIN）
  type              String

  /// 购买时快照的渲染值 —— 商品事后改动不回溯已购用户 [1.3.3]
  renderValue       String

  /// 购买时快照的样式 key
  renderStyle       String?

  /// 实付价格快照（后台客诉排查「我当时花了多少」）
  price             Int

  /// 本次生效起始时间
  startAt           DateTime

  /// 到期时间；过期记录不删除 [R46]，置灰展示 + 一键续费
  expireAt          DateTime

  /// 到期通知已发送的时间；null 表示未发。到期提醒的幂等标记 [T2]，
  /// 不用 Redis —— 丢了会重复轰炸用户，「只应发生一次」的标记必须持久化
  expiredNotifiedAt DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  /// 一个用户对同一商品只有一行，续费=延长 expireAt，避免「我的」列表堆积历史行
  @@unique([userId, itemId])

  /// 「我的装饰」按用户查、按到期时间倒序
  @@index([userId, type, expireAt(sort: Desc)])

  /// 后台按商品查持有者 + 商品删除守卫的存在性检查 [2.2][2.3]
  @@index([itemId])
  @@map("user_decorations")
}

/// 打赏记录（账本；不可撤销、不追溯 [R53]）
model Tip {
  /// 打赏记录 ID
  id         Int      @id @default(autoincrement())

  /// 打赏者 ID
  fromUserId Int

  /// 接收者 ID（内容作者）。冗余存储而非 JOIN 内容表取 —— 内容删除后仍要能按接收方聚合 [T4][2.5]
  toUserId   Int

  /// 打赏目标类型：post | comment
  targetType String

  /// 目标 ID。裸 ID 不建外键 —— 账务记录的生命周期独立于业务内容 [T4]，
  /// 与 PointLog.refId 同口径。内容删除后本行保留，后台按「内容已删除」渲染
  targetId   Int

  /// 打赏金额（鸡腿）；不抽水，全额到账 [R47]
  amount     Int

  /// 打赏留言，最长 20 字，选填 [1.5.3]
  message    String?

  createdAt  DateTime @default(now())

  /// [R48] 每人每个内容只能打赏一次。三列均非空，PG 唯一约束天然生效（不可用可空 postId 表达，见 T6）
  /// 同时承担并发重复提交的幂等兜底
  @@unique([fromUserId, targetType, targetId])

  /// 帖子/评论详情的打赏者列表（按时间倒序）
  @@index([targetType, targetId, createdAt(sort: Desc)])

  /// 后台按发送方聚合 —— 排查小号搬运的第一入口 [2.5]
  @@index([fromUserId, createdAt(sort: Desc)])

  /// 后台按接收方聚合
  @@index([toUserId, createdAt(sort: Desc)])
  @@map("tips")
}

/// 悬赏记录（一帖一悬赏）[1.5]
model Bounty {
  /// 悬赏 ID
  id                Int       @id @default(autoincrement())

  /// 悬赏帖 ID。裸 ID 不建外键（同 Tip，见 T4）；一帖一悬赏故唯一
  postId            Int       @unique

  /// 发起人 ID
  userId            Int

  /// 托管金额。发起时已从发起人余额一次性扣除，托管金不落在任何用户账户，仅作记账存在 [1.6.2]
  amount            Int

  /// 状态：escrow(托管中) | settled(已采纳) | refunded(已退款)。状态流转一律条件更新，保证幂等 [1.6.2]
  status            String    @default("escrow")

  /// 超时时间 = 发起时刻 + 配置天数（默认 7）。定时结算的判定依据 [1.6.3]
  expireAt          DateTime

  /// 被采纳的回答评论 ID（结算快照）；该评论事后被删不影响已结算状态 [1.6.6]
  acceptedCommentId Int?

  /// 被采纳的回答者 ID（结算快照）
  acceptedUserId    Int?

  /// 实发金额 = amount − fee；退款时为 null
  payout            Int?

  /// 手续费（销毁，计入悬赏账目）[1.6.2]；退款不抽水，故退款时为 null [1.6.2]
  fee               Int?

  /// 结算方式：accept(人工采纳) | auto(超时自动判给最高赞) | cancel(发起人取消) | admin(后台人工退款)
  settleType        String?

  /// 结算时间；未结算为 null
  settledAt         DateTime?

  /// 后台人工退款的操作者用户名（审计追责，与 PointLog.operator 同口径）[2.4]
  operator          String?

  createdAt         DateTime  @default(now())

  /// 定时扫描的驱动索引：捞出「仍托管中 且 已到期」的悬赏 [2.4]
  @@index([status, expireAt])

  /// 发起门槛校验：单用户同时进行中的悬赏数上限 [1.8]
  @@index([userId, status])
  @@map("bounties")
}

// ══════════════════════════════════════════════════════════════════════
// 私信（Direct Message，1v1 会话化设计，预留群聊扩展）
// ══════════════════════════════════════════════════════════════════════

/// 私信会话（1v1；userAId/userBId 规范排序 userAId < userBId，保证 (userAId,userBId) 唯一查找）
model Conversation {
  /// 会话 ID，自增主键
  id                 Int       @id @default(autoincrement())

  /// 参与方 A（规范排序中较小的用户 ID）
  userAId            Int

  /// 参与方 B（规范排序中较大的用户 ID）
  userBId            Int

  /// 最后一条消息 ID（列表定位 / 游标）
  lastMessageId      Int?

  /// 最后一条消息预览（截断，会话列表展示用）
  lastMessagePreview String?

  /// 最后一条消息时间（会话列表排序）
  lastMessageAt      DateTime?

  /// userA 侧未读数（冗余，发送时 +1、已读时清零）
  unreadCountA       Int       @default(0)

  /// userB 侧未读数（冗余）
  unreadCountB       Int       @default(0)

  /// 创建时间
  createdAt          DateTime  @default(now())

  /// 最后更新时间
  updatedAt          DateTime  @updatedAt

  /// 会话下的消息
  messages           Message[]

  /// 参与方对唯一（规范排序后）
  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt(sort: Desc)])
  @@index([userBId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

/// 私信消息
model Message {
  /// 消息 ID，自增主键
  id             Int          @id @default(autoincrement())

  /// 所属会话 ID，会话删除时级联删除消息
  conversationId Int

  /// 所属会话
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// 发送者 ID
  senderId       Int

  /// 消息正文（纯文本，v1）
  content        String       @db.Text

  /// 发送时间
  createdAt      DateTime     @default(now())

  /// 已读时间（已读回执，phase 2 用；null 表示未读）
  readAt         DateTime?

  /// 会话内按时间升序拉取 + 游标分页
  @@index([conversationId, createdAt])
  @@index([conversationId, id])
  @@map("messages")
}
