generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  /// 用户 ID，自增主键
  id            Int       @id @default(autoincrement())

  /// 用户名，唯一，3-20 字符，用于展示和 @提及
  username      String    @unique

  /// 邮箱，唯一；TG 注册时为空(null)，绑定邮箱后才有值
  email         String?   @unique

  /// argon2id 密码哈希；TG 注册时为空(null)，绑定邮箱设密码后才有值
  passwordHash  String?

  /// 头像 URL；TG 注册自动填 TG 头像；邮箱注册默认 null（前端展示默认头像）
  avatar        String?

  /// 个人简介，最长 200 字符
  bio           String?

  /// 用户等级：claw(鸡爪/新手) | leg(鸡腿/中级) | meat(鸡肉/高级)
  level         String    @default("claw")

  /// 鸡腿积分，通过签到/发帖/评论获得
  points        Int       @default(0)

  /// 星辰(特殊积分)，通过精华帖/管理奖励获得
  stars         Int       @default(0)

  /// 发帖总数，冗余字段，避免每次 COUNT 查询
  postCount     Int       @default(0)

  /// 评论总数，冗余字段，避免每次 COUNT 查询
  commentCount  Int       @default(0)

  /// 管理角色：user(普通用户) | mod(版主) | admin(管理员)
  role          String    @default("user")

  /// 账号状态：active(正常) | banned(封禁) | muted(禁言)
  status        String    @default("active")

  /// 第三方登录来源：'telegram' 表示 TG 用户；本站邮箱注册为 null
  oauthProvider String?

  /// TG 平台返回的用户 ID(纯数字字符串)；本站邮箱注册为 null
  oauthId       String?   @unique

  /// 邮箱是否已验证（MVP 阶段暂不强制，预留字段）
  emailVerified Boolean   @default(false)

  /// 累计上传图片总字节数，上传前校验不超过 UPLOAD_MAX_USER_TOTAL_SIZE
  uploadSize    Int       @default(0)

  /// 累计获得鸡腿（只增不减），等级升级依据 [R20]
  totalPointsEarned Int   @default(0)

  /// 连续签到天数，断签归零 [R13]
  checkinStreak Int       @default(0)

  /// 累计签到天数，永不归零 [R13]
  checkinTotalDays Int    @default(0)

  /// 上次签到时间，用于判断是否断签 [R13]
  lastCheckinAt DateTime?

  /// 积分流水记录
  pointLogs     PointLog[]

  /// 注册时间
  createdAt     DateTime  @default(now())

  /// 最后更新时间
  updatedAt     DateTime  @updatedAt

  /// 用户发布的帖子
  posts         Post[]

  /// 用户发布的评论
  comments      Comment[]

  /// 用户的帖子点赞记录
  postLikes     PostLike[]

  /// 用户的评论点赞记录
  commentLikes  CommentLike[]

  /// 粉丝数（冗余，关注/取关时同步增减，避免 COUNT）
  followerCount  Int           @default(0)

  /// 关注数（冗余）
  followingCount Int           @default(0)

  /// 用户的收藏记录
  bookmarks      Bookmark[]

  /// 关注关系（用户主动关注的人）
  following      Follow[]      @relation("Follows")

  /// 关注关系（关注该用户的人）
  followers      Follow[]      @relation("Followers")

  /// 用户的通知
  notifications  Notification[]

  @@index([status])
  @@map("users")
}

/// 论坛帖子
model Post {
  /// 帖子 ID，自增主键
  id           Int       @id @default(autoincrement())

  /// 帖子标题，1-200 字符
  title        String

  /// Markdown 格式正文
  content      String    @db.Text

  /// 所属板块，对应 Category 枚举值：general | llm | agent | prompt | art | opensource | tools | paper | share
  category     String

  /// 标签列表，最多 5 个，每个最长 20 字符，用 PG 数组存储 + GIN 索引
  tags         String[]

  /// 作者 ID
  authorId     Int

  /// 作者
  author       User      @relation(fields: [authorId], references: [id])

  /// 浏览量（Redis 去重计数后定时回写）
  viewCount    Int       @default(0)

  /// 点赞数（冗余字段，点赞时更新）
  likeCount    Int       @default(0)

  /// 评论数（冗余字段，发评论时更新）
  commentCount Int       @default(0)

  /// 热度分（物化列：likeCount*300 + commentCount*200 + viewCount，点赞/评论/浏览写路径增量维护）
  heatScore    Int       @default(0)

  /// 是否置顶，置顶帖列表优先展示（admin 模块后续提供置顶 API）
  isPinned     Boolean   @default(false)

  /// 发布时间
  createdAt    DateTime  @default(now())

  /// 最后更新时间（编辑后自动更新，前端展示"最后编辑于"）
  updatedAt    DateTime  @updatedAt

  /// 帖子下的评论
  comments     Comment[]

  /// 帖子的点赞记录
  likes        PostLike[]

  /// 帖子的收藏记录
  bookmarks    Bookmark[]

  @@index([category, createdAt(sort: Desc)])
  @@index([authorId])
  @@index([createdAt])
  @@index([tags], type: Gin) // 标签筛选 GIN 索引，tags: { has: tag } 查询依赖
  // 置顶优先 + 时间倒序（latest 首页/板块列表），让 orderBy([isPinned, createdAt]) 走索引
  @@index([isPinned, createdAt(sort: Desc)])
  @@index([category, isPinned, createdAt(sort: Desc)])
  // 热度窗口扫描：索引服务 hot 列表的 WHERE createdAt >= 7d 范围过滤；排序首键 isPinned 无法并入本索引，
  // 残余 isPinned+heatScore 排序为有界窗口内小集合显式排序（可接受，已消除全量拉回内存 JS 排序）
  @@index([createdAt, heatScore(sort: Desc)])
  @@map("posts")
}

/// 帖子评论（支持楼中楼回复）
model Comment {
  /// 评论 ID，自增主键
  id        Int       @id @default(autoincrement())

  /// Markdown 格式评论内容
  content   String    @db.Text

  /// 所属帖子 ID，帖子删除时级联删除评论
  postId    Int

  /// 所属帖子
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// 评论者 ID
  authorId  Int

  /// 评论者
  author    User      @relation(fields: [authorId], references: [id])

  /// 回复目标评论 ID，null 表示顶层楼层，有值表示楼中楼回复
  parentId  Int?

  /// 回复的目标评论（删除父评论时级联删除其所有楼中楼回复）
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)

  /// 该评论下的楼中楼回复
  replies   Comment[] @relation("CommentReplies")

  /// 楼层号（同一帖子内唯一），顶层评论才分配，楼中楼回复为 null
  floor     Int?

  /// 点赞数（冗余字段，点赞时更新）
  likeCount Int       @default(0)

  /// 评论时间
  createdAt DateTime  @default(now())

  /// 评论的点赞记录
  likes     CommentLike[]

  @@unique([postId, floor])
  @@index([postId, createdAt])
  @@index([authorId])
  @@map("comments")
}

/// 帖子点赞记录
model PostLike {
  /// 点赞记录 ID
  id        Int      @id @default(autoincrement())

  /// 被点赞的帖子 ID，帖子删除时级联删除
  postId    Int

  /// 被点赞的帖子
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// 点赞用户 ID
  userId    Int

  /// 点赞用户
  user      User     @relation(fields: [userId], references: [id])

  /// 点赞时间
  createdAt DateTime @default(now())

  /// 是否仍处于点赞状态；取消点赞置 false 保留记录，重赞时不重复发分
  active    Boolean  @default(true)

  /// 同一用户对同一帖子只能点一次赞
  @@unique([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

/// 评论点赞记录
model CommentLike {
  /// 点赞记录 ID
  id        Int      @id @default(autoincrement())

  /// 被点赞的评论 ID，评论删除时级联删除
  commentId Int

  /// 被点赞的评论
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  /// 点赞用户 ID
  userId    Int

  /// 点赞用户
  user      User     @relation(fields: [userId], references: [id])

  /// 点赞时间
  createdAt DateTime @default(now())

  /// 是否仍处于点赞状态；取消点赞置 false 保留记录，重赞时不重复发分
  active    Boolean  @default(true)

  /// 同一用户对同一评论只能点一次赞
  @@unique([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

/// 积分流水记录
model PointLog {
  /// 流水 ID，自增主键
  id           Int      @id @default(autoincrement())

  /// 用户 ID
  userId       Int

  /// 用户
  user         User     @relation(fields: [userId], references: [id])

  /// 积分来源：checkin(签到) | post(发帖) | comment(评论) | liked(被点赞) | transfer(管理调整)
  type         String

  /// 变动值（正数加分；transfer 管理调整可为负）[R41]
  delta        Int

  /// 变动后的鸡腿余额，用于流水对账 [R42]
  balanceAfter Int

  /// 关联的帖子/评论 ID，用于溯源，无关联为 null
  refId        Int?

  /// 操作者（管理调整 transfer 时记录是哪个管理员操作的），非 transfer 流水为 null
  operator     String?

  /// 变动时间
  createdAt    DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("point_logs")
}

/// 论坛板块分类（DB 驱动，替代 constants/business.ts 里的写死常量）
model Category {
  /// 分类 ID，自增主键
  id        Int      @id @default(autoincrement())

  /// 板块 slug，对应 posts.category 字段值，唯一
  slug      String   @unique

  /// 板块中文名
  name      String

  /// 板块 emoji 图标
  icon      String   @default("📂")

  /// 排序权重，越小越靠前
  sortOrder Int      @default(0)

  /// 是否启用（禁用后从 /api/categories 隐藏、发帖不可选）
  isEnabled Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

/// 论坛公告
model Announcement {
  /// 公告 ID，自增主键
  id        Int      @id @default(autoincrement())

  /// 公告标题，1-200 字符
  title     String

  /// 公告类型：normal(普通) | important(重要) | urgent(紧急) | activity(活动)
  type      String   @default("normal")

  /// 跳转链接；站内路径(/post/1)或外链，null 表示不可点击
  link      String?

  /// 排序权重，越大越靠前
  sortOrder Int      @default(0)

  /// 是否上线（false 为草稿，前台不展示）
  isActive  Boolean  @default(true)

  /// 创建时间
  createdAt DateTime @default(now())

  /// 最后更新时间
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder(sort: Desc)])
  @@map("announcements")
}

/// 论坛广告位
model Advert {
  /// 广告 ID，自增主键
  id        Int      @id @default(autoincrement())

  /// 广告标题（后台识别 + img alt），可空
  title     String?

  /// banner 图片 URL（后台 cl-upload 返回的完整 URL）
  image     String

  /// 广告位置：sidebar(侧边栏) | inline(列表内嵌)
  position  String   @default("sidebar")

  /// 跳转链接；站内路径(/post/1)或外链，null 表示不可点击
  link      String?

  /// 排序权重，越大越靠前
  sortOrder Int      @default(0)

  /// 是否上线（false 为草稿，前台不展示）
  isActive  Boolean  @default(true)

  /// 创建时间
  createdAt DateTime @default(now())

  /// 最后更新时间
  updatedAt DateTime @updatedAt

  @@index([position, isActive, sortOrder(sort: Desc)])
  @@map("adverts")
}

/// 帖子收藏（私密，仅本人可见）
model Bookmark {
  /// 收藏记录 ID
  id        Int      @id @default(autoincrement())

  /// 收藏用户 ID
  userId    Int

  /// 收藏用户
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 被收藏的帖子 ID，帖子删除时级联删除收藏记录
  postId    Int

  /// 被收藏的帖子
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// 收藏时间
  createdAt DateTime @default(now())

  /// 同一用户对同一帖子只能收藏一次
  @@unique([userId, postId])
  @@index([postId])
  @@map("bookmarks")
}

/// 关注关系（单向 follow：follower 关注 followee，Twitter 式非双向好友）
model Follow {
  /// 关注记录 ID
  id         Int      @id @default(autoincrement())

  /// 关注者 ID（主动关注的一方）
  followerId Int

  /// 关注者
  follower   User     @relation("Follows", fields: [followerId], references: [id], onDelete: Cascade)

  /// 被关注者 ID
  followeeId Int

  /// 被关注者
  followee   User     @relation("Followers", fields: [followeeId], references: [id], onDelete: Cascade)

  /// 关注时间
  createdAt  DateTime @default(now())

  /// 同一用户对同一目标只能关注一次
  @@unique([followerId, followeeId])
  @@index([followeeId])
  @@map("follows")
}

/// 站内通知
model Notification {
  /// 通知 ID
  id        Int      @id @default(autoincrement())

  /// 接收者 ID
  userId    Int

  /// 接收者
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 通知类型：comment(评论我的帖子) | reply(回复我的评论) | like(被点赞，聚合) | follow(被关注) | system(系统通知)
  type      String

  /// 触发者 ID 列表，只保留最近 3 个（防无界数组 + 整列重写）；总数见 actorCount
  actorIds  Int[]

  /// 触发者总数（聚合通知的累计事件数，like/follow 因唯一约束等于不同人数；comment 为评论次数近似）
  actorCount Int    @default(0)

  /// 关联帖子 ID（comment/reply/like-post 用；system 可选跳转；帖子删除后跳转会失效，前端兜底）
  postId    Int?

  /// 关联评论 ID（reply/like-comment 用）
  commentId Int?

  /// 群发消息 ID（system 通知指向 notification_messages 表，正文不逐行冗余；其余类型为 null）
  messageId Int?

  /// 通知正文（system 通知用；comment/reply/like 由关联对象推导，可空）
  /// 新群发不再逐行写正文，由 messageId 指向 notification_messages；存量行仍用本列兜底
  content   String?

  /// 是否已读
  isRead    Boolean  @default(false)

  /// 通知时间
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([messageId])
  @@map("notifications")
}

/// 系统通知群发正文（广播时正文只存一份，通知行通过 messageId 引用，避免逐用户冗余存储）
model NotificationMessage {
  /// 消息 ID
  id        Int      @id @default(autoincrement())

  /// 通知正文
  content   String   @db.Text

  /// 跳转帖子 ID（可选）
  postId    Int?

  /// 实际送达用户数
  sentCount Int      @default(0)

  /// 创建时间
  createdAt DateTime @default(now())

  @@map("notification_messages")
}
